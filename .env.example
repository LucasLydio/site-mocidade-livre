# App
NODE_ENV=development
APP_NAME="mocidadelivre-api"
APP_URL="http://localhost:8888"
FRONTEND_URL="https://mocidadelivre.netlify.app/"
FRONTEND_URL_DEV="http://localhost:8888"

# CORS
CORS_ORIGIN="https://mocidadelivre.netlify.app/"
CORS_DEV="http://localhost:8888"

# Supabase
SUPABASE_URL="https://bubevotdvrbofnixiogb.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Backend only. Never expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.bubevotdvrbofnixiogb:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.bubevotdvrbofnixiogb:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Redis Upstash
UPSTASH_REDIS_REST_URL="https://first-ghoul-119265.upstash.io"
UPSTASH_REDIS_REST_TOKEN="********"


# Resend
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Your App <noreply@yourdomain.com>"

# Auth / Security
JWT_SECRET="change-this-to-a-random-secret-with-at-least-32-characters"
JWT_ISSUER="ml-api"
JWT_EXPIRES_IN="7d"
JWT_AUDIENCE="authenticated"
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Optional initial admin for backend/prisma/seed.ts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Rate Limit
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Cache
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_CONTENT_TTL_SECONDS=300
CACHE_CATALOG_TTL_SECONDS=120
CACHE_AUTHZ_TTL_SECONDS=300
CACHE_KEY_PREFIX="mocidade-livre:v1"

# Logs
LOG_LEVEL="info"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="your-google-app-password"
EMAIL_FROM="Your App <yourgmail@gmail.com>"

# --- Storage ---
# Supabase Storage bucket for product images
STORAGE_BUCKET_FILES_UPLOAD=mocidade_livre
