    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3"
